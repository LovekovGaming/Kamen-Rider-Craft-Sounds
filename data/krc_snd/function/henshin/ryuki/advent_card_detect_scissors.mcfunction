advancement revoke @s only krc_snd:henshin/ryuki/advent_card_detect_scissors
execute as @n[type=item,predicate=krc_snd:valid_item,distance=..2] if items entity @s contents kamenridercraft:scissors_pinch unless score @s krc.seq1 matches 0.. store success score @s krc.seq1 run data get entity @s Thrower
execute as @n[type=item,predicate=krc_snd:valid_item,distance=..2] if items entity @s contents kamenridercraft:shell_defense unless score @s krc.seq1 matches 0.. store success score @s krc.seq1 run data get entity @s Thrower
execute if score @n[type=item,predicate=krc_snd:valid_item,distance=..2] krc.seq1 matches 0 if score @s krc.configs.ryuki_type matches 0 run function krc_snd:play_global {name:"kamenridercraft:visor_close",scope:"henshin_snd"}
execute if score @n[type=item,predicate=krc_snd:valid_item,distance=..2] krc.seq1 matches 0 if score @s krc.configs.ryuki_type matches 1 run function krc_snd:play_global {name:"kamenridercraft:visor_close_dragon_knight",scope:"henshin_snd"}
execute if score @n[type=item,predicate=krc_snd:valid_item,distance=..2] krc.seq1 matches 0 run scoreboard players reset @s krc.henshin-stage
execute if score @n[type=item,predicate=krc_snd:valid_item,distance=..2] krc.seq1 matches 0 run advancement grant @s only krc_snd:henshin/ryuki/advent_card_sound 1
execute if entity @s[advancements={krc_snd:henshin/ryuki/advent_card_sound={1=true}}] if items entity @n[type=item,predicate=krc_snd:valid_item,distance=..2] contents kamenridercraft:scissors_pinch run advancement grant @s only krc_snd:henshin/ryuki/advent_card_sound strike_vent
execute if entity @s[advancements={krc_snd:henshin/ryuki/advent_card_sound={1=true}}] if items entity @n[type=item,predicate=krc_snd:valid_item,distance=..2] contents kamenridercraft:shell_defense run advancement grant @s only krc_snd:henshin/ryuki/advent_card_sound guard_vent