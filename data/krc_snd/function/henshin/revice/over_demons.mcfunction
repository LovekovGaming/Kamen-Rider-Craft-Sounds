execute if entity @s[tag=sound_off] run return 0
function krc_snd:henshin/reset_henshin {series:revice}
advancement grant @s only krc_snd:henshin/revice/over_demons_seq 1
tag @s remove demons_henshin
stopsound @a[scores={krc.configs.henshin_snd=1},distance=..20] player kamenridercraft:demons_standby
stopsound @a[scores={krc.configs.henshin_snd=1},distance=..20] player kamenridercraft:genomix_standby
stopsound @a[scores={krc.configs.henshin_snd=1},distance=..20] player kamenridercraft:vistamp_down
