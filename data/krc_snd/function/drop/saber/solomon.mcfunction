execute if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:omni_force_wonder_ride_book run scoreboard players add @s krc.henshin-stage 1
execute if score @s krc.henshin-stage matches 6.. run scoreboard players reset @s krc.henshin-stage

execute if score @s krc.henshin-stage matches 2 if predicate krc_core:sneaking if entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] run scoreboard players set @s krc.henshin-stage 4
execute if score @s krc.henshin-stage matches 1 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:omni_force_wonder_ride_book run playsound kamenridercraft:omni_force_open player @a[scores={krc.configs.henshin_snd=1}] ~ ~1 ~ 3
execute if score @s krc.henshin-stage matches 1 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:omni_force_wonder_ride_book run title @a[scores={krc.configs.sound_subs=1},distance=..20] actionbar {"translate":"sound.kamenridercraft.saber.omni_force_name","color":"red"}
execute if score @s krc.henshin-stage matches 2 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:omni_force_wonder_ride_book run playsound kamenridercraft:omni_force_story player @a[scores={krc.configs.henshin_snd=1}] ~ ~1 ~ 3
execute if score @s krc.henshin-stage matches 2 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:omni_force_wonder_ride_book run title @a[scores={krc.configs.sound_subs=1},distance=..20] actionbar {"translate":"sound.kamenridercraft.saber.omni_force_story","color":"red"}
execute if score @s krc.henshin-stage matches 3 unless predicate krc_core:sneaking if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:omni_force_wonder_ride_book run scoreboard players set @s krc.henshin-stage 4
execute if score @s krc.henshin-stage matches 3 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:omni_force_wonder_ride_book run playsound kamenridercraft:omni_force_story_2 player @a[scores={krc.configs.henshin_snd=1}] ~ ~1 ~ 3
execute if score @s krc.henshin-stage matches 3 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:omni_force_wonder_ride_book run title @a[scores={krc.configs.sound_subs=1},distance=..20] actionbar {"translate":"sound.kamenridercraft.saber.omni_force_story_2","color":"red"}
execute if score @s krc.henshin-stage matches 4 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:omni_force_wonder_ride_book run advancement grant @s only krc_snd:henshin/saber/solomon_standby 1
execute if score @s krc.henshin-stage matches 4 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:omni_force_wonder_ride_book run playsound kamenridercraft:omni_force_insert player @a[scores={krc.configs.henshin_snd=1}] ~ ~1 ~ 3

execute as @n[type=item,distance=..5,predicate=krc_snd:valid_item] if items entity @s contents kamenridercraft:omni_force_wonder_ride_book run function krc_snd:drop/common/return_item
execute if score @s krc.henshin-stage matches 5 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:omni_force_wonder_ride_book run advancement revoke @s from krc_snd:henshin/saber/root
execute if score @s krc.henshin-stage matches 5 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:omni_force_wonder_ride_book run function krc_snd:drop/common/equip_armor {slot: "armor.head", item: "kamenridercraft:saberhead"}
execute if score @s krc.henshin-stage matches 5 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:omni_force_wonder_ride_book run function krc_snd:drop/common/equip_armor {slot: "armor.chest", item: "kamenridercraft:sabertroso"}
execute if score @s krc.henshin-stage matches 5 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:omni_force_wonder_ride_book run function krc_snd:drop/common/equip_armor {slot: "armor.legs", item: "kamenridercraft:saberlegs"}
advancement revoke @s from krc_snd:drop/saber/root
advancement revoke @s only krc_snd:henshin/common/reset