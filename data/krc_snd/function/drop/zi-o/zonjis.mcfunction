execute if score @s krc.henshin-stage matches 5 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:zonjis_ridewatch run function krc_snd:drop/common/equip_armor {slot: "armor.chest", item: "kamenridercraft:zi_o_troso"}
