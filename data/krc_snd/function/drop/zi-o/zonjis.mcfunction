execute if score @s krc.henshin-stage matches 3 if predicate krc_core:sneaking if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:zonjis_ridewatch run title @a[scores={krc.configs.sound_subs=1},distance=..20] actionbar {"translate":"sound.kamenridercraft.zi-o.zonjis_desc","color":"green"}
