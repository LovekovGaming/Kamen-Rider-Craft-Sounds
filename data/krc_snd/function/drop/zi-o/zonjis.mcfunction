execute if score @s krc.henshin-stage matches 1 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:zonjis_ridewatch run playsound kamenridercraft:ridewatch_turn player @a[scores={krc.configs.henshin_snd=1}] ~ ~1 ~
