execute if score @s krc.henshin-stage matches 2 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:zonjis_ridewatch run advancement grant @s only krc_snd:henshin/zi-o/ridewatches zonjis
