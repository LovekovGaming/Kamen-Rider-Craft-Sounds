execute if score @s krc.henshin-stage matches 3 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:zonjis_ridewatch run scoreboard players set @s krc.seq1 0
execute if score @s krc.henshin-stage matches 3 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:zonjis_ridewatch run advancement grant @s only krc_snd:henshin/zi-o/zi-o_standby 1
