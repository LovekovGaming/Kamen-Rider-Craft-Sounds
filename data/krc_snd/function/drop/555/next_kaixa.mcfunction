execute if score @s krc.henshin-stage matches 6 unless predicate krc_core:heisei/faiz_armor if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:kaixa_phone_xx run function krc_snd:drop/common/equip_armor {slot: "armor.chest", item: "kamenridercraft:faiztroso"}
