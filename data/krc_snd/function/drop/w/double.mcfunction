execute if score @s[tag=!l_memory] krc.henshin-stage matches 1..2 if entity @n[type=item,distance=..5,tag=valid,tag=l_memory] run tag @s add l_memory
execute if score @s[tag=!r_memory] krc.henshin-stage matches 1..2 if entity @n[type=item,distance=..5,tag=valid,tag=r_memory] run tag @s add r_memory
execute if score @s krc.henshin-stage matches 2 if entity @n[type=item,distance=..5,tag=valid,tag=xtreme] run tag @s add l_memory
execute if score @s krc.henshin-stage matches 2 if entity @n[type=item,distance=..5,tag=valid,tag=xtreme] run tag @s add r_memory

execute if score @s krc.henshin-stage matches 3..4 if entity @n[type=item,distance=..5,tag=valid] run tag @s remove fang_memory
execute if score @s krc.henshin-stage matches 3..4 if entity @n[type=item,distance=..5,tag=valid] run advancement grant @s only krc_snd:henshin/w/double_standby 1
execute if score @s[tag=l_memory,tag=!r_memory] krc.henshin-stage matches 4 if entity @n[type=item,distance=..5,tag=valid,tag=r_memory] run scoreboard players remove @s krc.henshin-stage 1
execute if score @s[tag=r_memory,tag=!l_memory] krc.henshin-stage matches 4 if entity @n[type=item,distance=..5,tag=valid,tag=l_memory] run scoreboard players remove @s krc.henshin-stage 1
execute if score @s[tag=l_memory] krc.henshin-stage matches 3..4 if entity @n[type=item,distance=..5,tag=valid,tag=l_memory] unless items entity @n[type=item,distance=..5,tag=valid] contents kamenridercraft:shippu_memory run playsound kamenridercraft:memory_in player @a[scores={krc.configs.henshin_snd=1}] ~ ~1 ~
execute if score @s[tag=r_memory] krc.henshin-stage matches 3..4 if entity @n[type=item,distance=..5,tag=valid,tag=r_memory] unless items entity @n[type=item,distance=..5,tag=valid] contents kamenridercraft:kirifuda_memory run playsound kamenridercraft:memory_in player @a[scores={krc.configs.henshin_snd=1}] ~ ~1 ~
execute if score @s[tag=l_memory] krc.henshin-stage matches 3..4 if entity @n[type=item,distance=..5,tag=valid,tag=l_memory] if items entity @n[type=item,distance=..5,tag=valid] contents kamenridercraft:shippu_memory run playsound kamenridercraft:memory_in_jidaigeki player @a[scores={krc.configs.henshin_snd=1}] ~ ~1 ~
execute if score @s[tag=l_memory] krc.henshin-stage matches 3..4 if entity @n[type=item,distance=..5,tag=valid,tag=l_memory] if items entity @n[type=item,distance=..5,tag=valid] contents kamenridercraft:shippu_memory run tag @s add shippu_in
execute if score @s[tag=r_memory] krc.henshin-stage matches 3..4 if entity @n[type=item,distance=..5,tag=valid,tag=r_memory] if items entity @n[type=item,distance=..5,tag=valid] contents kamenridercraft:kirifuda_memory run playsound kamenridercraft:memory_in_jidaigeki player @a[scores={krc.configs.henshin_snd=1}] ~ ~1 ~
execute if score @s[tag=r_memory] krc.henshin-stage matches 3..4 if entity @n[type=item,distance=..5,tag=valid,tag=r_memory] if items entity @n[type=item,distance=..5,tag=valid] contents kamenridercraft:kirifuda_memory run tag @s add kirifuda_in
execute if score @s[tag=l_memory] krc.henshin-stage matches 3..4 if entity @n[type=item,distance=..5,tag=valid,tag=l_memory] run tag @s remove l_memory
execute if score @s[tag=r_memory] krc.henshin-stage matches 3..4 if entity @n[type=item,distance=..5,tag=valid,tag=r_memory] run tag @s remove r_memory
execute if score @s krc.henshin-stage matches 3 if entity @n[type=item,distance=..5,tag=valid,tag=xtreme] run scoreboard players set @s krc.henshin-stage 4
execute if score @s krc.henshin-stage matches 3..4 if entity @n[type=item,distance=..5,tag=valid,tag=xtreme] run playsound kamenridercraft:memory_in player @a[scores={krc.configs.henshin_snd=1}] ~ ~1 ~
execute if score @s krc.henshin-stage matches 4 if entity @n[type=item,distance=..5,tag=valid,tag=xtreme] run tag @s remove r_memory
execute if score @s krc.henshin-stage matches 4 if entity @n[type=item,distance=..5,tag=valid,tag=xtreme] run tag @s remove l_memory

execute if score @s krc.henshin-stage matches 5 if entity @n[type=item,distance=..5,tag=valid] run advancement revoke @s from krc_snd:henshin/w/root
execute if score @s krc.henshin-stage matches 5 unless predicate krc_core:heisei/w_armor if entity @n[type=item,distance=..5,tag=valid] run function krc_snd:drop/common/equip_armor {slot: "armor.head", item: "kamenridercraft:whead"}
execute if score @s krc.henshin-stage matches 5 unless predicate krc_core:heisei/w_armor if entity @n[type=item,distance=..5,tag=valid] run function krc_snd:drop/common/equip_armor {slot: "armor.chest", item: "kamenridercraft:wtroso"}
execute if score @s krc.henshin-stage matches 5 unless predicate krc_core:heisei/w_armor if entity @n[type=item,distance=..5,tag=valid] run function krc_snd:drop/common/equip_armor {slot: "armor.legs", item: "kamenridercraft:wlegs"}
execute if score @s krc.henshin-stage matches 5 if entity @n[type=item,distance=..5,tag=valid] run scoreboard players set @s krc.seq1 0
execute if score @s krc.henshin-stage matches 5 if entity @n[type=item,distance=..5,tag=valid] run stopsound @a[scores={krc.configs.henshin_snd=1},distance=..20] player kamenridercraft:double_standby
execute if score @s krc.henshin-stage matches 5 unless score @s krc.form1n matches 0 if entity @n[type=item,distance=..5,tag=valid] run tag @s remove shippu_in
execute if score @s krc.henshin-stage matches 5 unless score @s krc.form2n matches 0 if entity @n[type=item,distance=..5,tag=valid] run tag @s remove kirifuda_in
execute if score @s krc.henshin-stage matches 5.. run scoreboard players reset @s krc.henshin-stage
execute as @n[type=item,distance=..5,tag=valid] run function krc_snd:drop/common/return_item
advancement revoke @s from krc_snd:drop/w/root
advancement revoke @s only krc_snd:henshin/common/reset