execute if entity @n[type=item,distance=..5,tag=pick_up] run stopsound @a[scores={krc.configs.henshin_snd=1},distance=..20] player minecraft:entity.item.pickup
execute if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:ark_one_progrisekey run scoreboard players add @s krc.henshin-stage 1
execute if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:ark_one_progrisekey unless predicate krc_core:reiwa/zero-one_armor unless items entity @s armor.feet *[minecraft:custom_data~{slot_tex1:"kamenridercraft:ark_one_progrisekey"}|minecraft:custom_data~{slot_tex1:"kamenridercraft:ark_one_ride_chemy_card"}] run scoreboard players add @s krc.henshin-stage 2
execute if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:ark_one_progrisekey if score @s krc.form1n matches 2..3 run scoreboard players add @s krc.henshin-stage 2

execute if score @s krc.henshin-stage matches 1 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:ark_one_progrisekey run playsound kamenridercraft:ark-one_progrisekey player @a[scores={krc.configs.henshin_snd=1}] ~ ~1 ~ 3
execute if score @s krc.henshin-stage matches 1 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:ark_one_progrisekey run title @a[scores={krc.configs.sound_subs=1},distance=..20] actionbar {"translate":"sound.kamenridercraft.zero-one.ark-one_progrisekey"}
execute if score @s krc.henshin-stage matches 1 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:ark_one_progrisekey run advancement grant @s only krc_snd:henshin/zero-one/ark-one_standby 1
execute if score @s krc.henshin-stage matches 2 unless predicate krc_core:sneaking if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:ark_one_progrisekey run scoreboard players set @s krc.henshin-stage 3
execute if score @s krc.henshin-stage matches 2 if predicate krc_core:sneaking if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:ark_one_progrisekey run playsound kamenridercraft:ark-one_ability player @a[scores={krc.configs.henshin_snd=1}] ~ ~1 ~ 3
execute if score @s krc.henshin-stage matches 2 if predicate krc_core:sneaking if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:ark_one_progrisekey run title @a[scores={krc.configs.sound_subs=1},distance=..20] actionbar {"translate":"sound.kamenridercraft.zero-one.ark-one_ability"}
execute if score @s krc.henshin-stage matches 2 if predicate krc_core:sneaking if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:ark_one_progrisekey run scoreboard players set @s krc.henshin-stage 1

execute if score @s krc.henshin-stage matches 3 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:ark_one_progrisekey run advancement revoke @s from krc_snd:henshin/zero-one/root
execute if score @s krc.henshin-stage matches 3 unless predicate krc_core:reiwa/zero-one_armor if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:ark_one_progrisekey run function krc_snd:drop/common/equip_armor {slot: "armor.head", item: "kamenridercraft:zero_onehead"}
execute if score @s krc.henshin-stage matches 3 unless predicate krc_core:reiwa/zero-one_armor if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:ark_one_progrisekey run function krc_snd:drop/common/equip_armor {slot: "armor.chest", item: "kamenridercraft:zero_onetroso"}
execute if score @s krc.henshin-stage matches 3 unless predicate krc_core:reiwa/zero-one_armor if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:ark_one_progrisekey run function krc_snd:drop/common/equip_armor {slot: "armor.legs", item: "kamenridercraft:zero_onelegs"}
execute if score @s krc.henshin-stage matches 3 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:ark_one_progrisekey run scoreboard players set @s krc.seq1 0
execute if score @s krc.henshin-stage matches 3 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:ark_one_progrisekey run scoreboard players set @s krc.seq2 0
execute if score @s krc.henshin-stage matches 3 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:ark_one_progrisekey run stopsound @a[scores={krc.configs.henshin_snd=1},distance=..20] player kamenridercraft:ark-one_standby
execute if score @s krc.henshin-stage matches 3.. run scoreboard players reset @s krc.henshin-stage
execute as @n[type=item,distance=..5,predicate=krc_snd:valid_item] if items entity @s contents kamenridercraft:ark_one_progrisekey run function krc_snd:drop/common/return_item
advancement revoke @s from krc_snd:drop/zero-one/root