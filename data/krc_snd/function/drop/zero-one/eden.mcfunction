execute if score @s krc.henshin-stage matches 4 if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:eden_zetsumerisekey run function krc_snd:drop/common/equip_armor {slot: "armor.chest", item: "kamenridercraft:zero_onetroso"}
