execute if score @s krc.henshin-stage matches 3 if predicate krc_core:sneaking if items entity @n[type=item,distance=..5,predicate=krc_snd:valid_item] contents kamenridercraft:eden_zetsumerisekey run scoreboard players set @s krc.henshin-stage 2

